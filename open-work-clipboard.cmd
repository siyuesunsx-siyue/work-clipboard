@echo off
set SCRIPT_DIR=%~dp0
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$root = '%SCRIPT_DIR%'; $running = $false; try { $r = Invoke-WebRequest -Uri 'http://127.0.0.1:18765/' -UseBasicParsing -TimeoutSec 1; $running = $r.StatusCode -eq 200 } catch {}; if (-not $running) { Start-Process wscript.exe -ArgumentList ('\"' + $root + 'start-clipboard-watch-hidden.vbs\"') -WindowStyle Hidden }; $manifest = Get-Content (Join-Path $root 'manifest.json') -Raw | ConvertFrom-Json; $ext = Get-ChildItem \"$env:LOCALAPPDATA\\Google\\Chrome\\User Data\\Default\\Extensions\" -Directory -ErrorAction SilentlyContinue | Where-Object { Test-Path (Join-Path $_.FullName ($manifest.version + '\\manifest.json')) } | Where-Object { ((Get-Content (Join-Path $_.FullName ($manifest.version + '\\manifest.json')) -Raw | ConvertFrom-Json).name -eq $manifest.name) } | Select-Object -First 1; if ($ext) { Start-Process chrome.exe ('chrome-extension://' + $ext.Name + '/newtab.html') } else { Start-Process chrome.exe ((Join-Path $root 'newtab.html')) }"
